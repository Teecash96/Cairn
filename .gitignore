# Secrets — hardcoded credentials are a competition disqualifier
.env
.env.*
!.env.example

# `wrangler dev` reads secrets from .dev.vars, and it is NOT matched by .env*.
# The Gemini key lives here locally and in an encrypted Cloudflare secret
# binding in production — never in the repo.
.dev.vars
.dev.vars.*
!.dev.vars.example

# Wrangler's local state: a miniflare KV shim, build cache, and deploy metadata.
.wrangler/

