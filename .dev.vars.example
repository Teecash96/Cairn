# Copy this file to .dev.vars for local Worker development.
# Never commit .dev.vars. It is ignored by .gitignore.
GEMINI_API_KEY="replace-with-a-local-key"
GEMINI_MODEL="gemini-3.1-flash-lite"
# Local Worker only. Never set this on the deployed Worker.
DEV_TRUST_PAYMENTS="1"

# Local ledger only: production requires the documented cutover first.
CREDIT_LEDGER_READY="1"
